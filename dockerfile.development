# Build stage: installs dependencies (uses full node to allow building if needed)
FROM node:22-alpine AS build
WORKDIR /app

# Install dependencies (prefer package-lock for deterministic install)
COPY package*.json ./
RUN if [ -f package-lock.json ]; then \
      npm ci --silent; \
    else \
      npm install --silent; \
    fi

# Copy project files only if you want the image to build the dist here.
# In CI we typically upload/download `dist` artifact; copying `dist` is supported.
COPY . .

# If your project builds a production bundle, run it here (uncomment if needed)
# RUN npm run build


# Runtime stage: minimal image, non-root user for rootless Podman
FROM node:22-alpine AS runtime

# Create a dedicated non-root user and group
RUN addgroup -S appgroup && adduser -S app -G appgroup

# Use /app as requested
WORKDIR /app

# Copy only necessary runtime files from build stage or context
# Prefer using the pre-built `dist` artifact produced by CI. If `dist` exists
# in build stage, copy it; otherwise copy from current context.
COPY --from=build /app/dist ./dist
COPY --from=build /app/server.js ./server.js
COPY .env.development ./

# Ensure non-root user owns the files
RUN chown -R app:appgroup /app

USER app

# Use a non-privileged port (>1024) for rootless Podman compatibility
EXPOSE 10001
ENV PORT=10001
ENV HOST=0.0.0.0

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
  CMD wget -qO- http://127.0.0.1:10001/ || exit 1

CMD ["npm", "run", "server:dev"]