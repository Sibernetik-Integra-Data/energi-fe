FROM node:22-slim

WORKDIR /app

COPY package*.json ./

RUN npm install -g npm@latest
RUN node -v && npm -v

RUN if [ -f package-lock.json ]; then \
      npm ci --include=dev --verbose; \
    else \
      npm install --include=dev --verbose; \
    fi

COPY .env.development ./
COPY server.js ./
COPY dist ./dist

RUN chown -R node:node /app
USER node

EXPOSE 10001
ENV PORT=10001
ENV HOST=0.0.0.0

CMD ["npm", "run", "server:dev"]