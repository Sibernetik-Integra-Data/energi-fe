FROM node:22-slim

WORKDIR /app

COPY package*.json ./
RUN if [ -f package-lock.json ]; then \
      npm ci --include=dev; \
    else \
      npm install --include=dev; \
    fi

COPY .env.development ./
COPY server.js ./
COPY dist ./dist

RUN chown -R node:node /app
USER node

EXPOSE 10001
ENV PORT=10001

CMD ["npm", "run", "server:dev"]