# Runtime stage: minimal image, non-root user for rootless Podman
FROM node:22-alpine AS runtime

# Create a dedicated non-root user and group
RUN addgroup -S appgroup && adduser -S app -G appgroup && \
    mkdir -p /app && chown app:appgroup /app

# Use /app as requested
WORKDIR /app

# Copy only the runtime files needed by the container
# Copy the pre-built `dist` artifact from the build context downloaded by CI.
COPY --chown=app:appgroup dist ./dist
COPY --chown=app:appgroup .env.development ./.env.development
COPY --chown=app:appgroup server.js ./server.js

USER app

# Install only the server runtime dependencies needed by server.js
RUN npm install --no-save --silent cors@2.8.6 dotenv@17.4.2 express@5.2.1

# Use a non-privileged port (>1024) for rootless Podman compatibility
EXPOSE 10001
ENV NODE_ENV=development
ENV PORT=10001
ENV HOST=0.0.0.0

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
  CMD wget -qO- http://127.0.0.1:10001/ || exit 1

CMD ["node", "server.js"]